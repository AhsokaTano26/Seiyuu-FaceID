[Unit]
Description=Seiyuu FaceID local inference API
After=network.target

[Service]
Type=simple
User=faceid
Group=faceid
WorkingDirectory=/opt/seiyuu-faceid
EnvironmentFile=/etc/seiyuu-faceid.env
ExecStart=/opt/seiyuu-faceid/.venv/bin/uvicorn seiyuu_faceid.api.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --timeout-graceful-shutdown 60
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
